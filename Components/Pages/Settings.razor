@page "/settings"

<Modal Title="Restoring account" ModalButtonOptions="ModalButtonOptions.NONE" @bind-IsOpen="IsRestoring" IsCloseable="false">
    <p class="regular-p-grey">Please wait. The app will reload automatically after the account has been restored.</p>
</Modal>

<div>
    <Modal Title="Confirm" ModalButtonOptions="ModalButtonOptions.CANCEL" @bind-IsOpen="ShowConfirmLinkModal">
        <p class="regular-p-grey">Are you sure you want to open this link?</p>
        <a @onclick="@(() => { ShowConfirmLinkModal = false; NavigationManager.NavigateTo(LinkToOpen!); })" class="external-link">Url: @LinkToOpen</a>
    </Modal>
</div>

<Modal Title="Connecting to node" ModalButtonOptions="ModalButtonOptions.CANCEL" @bind-IsOpen="IsConnectingToMoneroNode" OnCancelPressed="() => { MoneroNodeConnectCancellationTokenSource?.Cancel(); }" IsCloseable="false">
    <p class="regular-p-grey">Please wait</p>
</Modal>

<div>
    <Modal Title="Connect to Monero node" ModalButtonOptions="ModalButtonOptions.OK_CANCEL" @bind-IsOpen="ShowConnectToMoneroNodeModal" OnOkPressed="async () => await ConnectToMoneroNodeAsync(MoneroNodeToConnectTo)" OkButtonText="Connect">
        <p class="regular-p-grey">Are you sure you want to connect to this Monero node?</p>
        <a class="external-link">Url: @MoneroNodeToConnectTo</a>
    </Modal>
</div>

<div>
    <Modal Title="Remove Monero node" ModalButtonOptions="ModalButtonOptions.OK_CANCEL" @bind-IsOpen="ShowRemoveMoneroNodeModal" OnOkPressed="async () => await RemoveMoneroNodeAsync(MoneroNodeToRemove)" OkButtonText="Remove">
        <p class="regular-p-grey">Are you sure you want to remove to this Monero node?</p>
        <a class="external-link">Url: @MoneroNodeToRemove</a>
    </Modal>
</div>

<Modal Title="Backup" ModalButtonOptions="ModalButtonOptions.CANCEL" @bind-IsOpen="IsBackingUp" OnCancelPressed="() => { try { BackupCts?.Cancel(); } catch { } }" IsCloseable="false">
    <p class="regular-p-grey">Please wait</p>
    <p class="regular-p-grey">Note: This can take a long time when using a remote node</p>
</Modal>
<Modal Title="Restore account" ModalButtonOptions="ModalButtonOptions.OK_CANCEL" @bind-IsOpen="ShowRestoreModal" OnOkPressed="RestoreFromBackupAsync" OkButtonText="Continue">
    <p class="regular-p-grey">Warning! This will delete your current account. Make sure you have made a backup</p>
</Modal>
<Modal Title="Connecting" ModalButtonOptions="ModalButtonOptions.NONE" IsOpen="ShowConnectToRemoteNodeModal" IsOpenChanged="@(async (isOpen) => { ShowConnectToRemoteNodeModal = isOpen; if (!isOpen) await CancelConnectToRemoteNodeAsync(); })">
    @if (IsConnected)
    {
        <p class="regular-p-grey">Connected successfully</p>
        <br />
        <button class="button-submit" @onclick="() => ShowConnectToRemoteNodeModal = false">Continue</button>
    }
    else
    {
        <p class="regular-p-grey">Make sure you have Orbot installed and "power user mode" enabled in settings to enable the proxy</p>
        <br />
        <button class="button-cancel" @onclick="CancelConnectToRemoteNodeAsync">Cancel</button>
    }
</Modal>
<Modal Title="Error" ModalButtonOptions="ModalButtonOptions.OK" IsOpen="@(!string.IsNullOrEmpty(ConnectionError))" IsOpenChanged="(isOpen) => { if (!isOpen) ConnectionError = null; }">
    <p class="regular-p-grey">@ConnectionError</p>
</Modal>
<Modal Title="Add Monero node" ModalButtonOptions="ModalButtonOptions.OK_CANCEL" @bind-IsOpen="ShowAddMoneroNodeModal" OnOkPressed="AddMoneroNodeAsync" OkButtonText="Add node">
    <div class="configure">
        <div>
            <label>Url</label>
            <input @bind="MoneroNodeUrl" @bind:event="oninput" />
            <p class="note">Example: http://192.168.0.1:18081</p>
            <p class="note">@IsMoneroNodeUrlInvalidReason</p>
        </div>
        <Toggle @bind-IsToggled="AuthenticationRequired" Text="Authentication required"></Toggle>
        @if (AuthenticationRequired)
        {
            <div>
                <label>Username</label>
                <input @bind="MoneroNodeUsername" />
            </div>
            <div>
                <label>Password</label>
                <input @bind="MoneroNodePassword" />
            </div>            
        }
    </div>
</Modal>
<div class="settings-main">
    <div class="info-container">
        <p class="bold-p">Build information</p>
        <p>App version: @(string.IsNullOrEmpty(Version) ? "Loading..." : Version)</p>
        <p>Haveno version: @(string.IsNullOrEmpty(HavenoVersion) ? "Loading..." : HavenoVersion)</p>
        <p>Daemon status: @(IsConnected ? "Connected" : "Disconnected")</p>
        <br />
        <div class="support-links-container">
            <p class="bold-p support-links-title">Support links</p>

            @if (!string.IsNullOrEmpty(AppConstants.GitHubLink))
            {
                <div class="link-container">
                    <img src="icons/github.svg" />
                    <a @onclick="() => { LinkToOpen = AppConstants.GitHubLink; ShowConfirmLinkModal = true; }">Source code</a>
                </div>
            }
@*             @if (!string.IsNullOrEmpty(AppConstants.MatrixLink))
            {
                <div class="link-container">
                    <img src="icons/matrix.svg" />
                    <a href="@AppConstants.GitHubLink">Matrix</a>
                </div>
            }
            @if (!string.IsNullOrEmpty(AppConstants.SimplexLink))
            {
                <div class="link-container">
                    <img src="icons/simplex.svg" />
                    <a href="@AppConstants.SimplexLink">Simplex</a>
                </div>
            } *@
        </div>
        <br />
        <p class="bold-p">Monero network</p>
        @if (UrlConnections.Count != 0)
        {
            <ul class="url-connections">
                @foreach (var urlConnection in UrlConnections.Where(x => DaemonInstallOption == DaemonInstallOptions.RemoteNode ? true : !x.Url.Contains("127.0.0.1")).OrderByDescending(x => x.Url == ConnectedMoneroNodeUrl).ThenBy(x => x.Priority))
                {
                    <li class=@(urlConnection.Url == ConnectedMoneroNodeUrl ? "connection connected" : "connection")>
                        @switch (urlConnection.OnlineStatus)
                        {
                            case OnlineStatus.UNKNOWN:
                                <div class="online-status unknown"></div>
                                break;
                            case OnlineStatus.ONLINE:
                                <div class="online-status online"></div>
                                break;
                            case OnlineStatus.OFFLINE:
                                <div class="online-status offline"></div>
                                break;
                        }
                        <p>@urlConnection.Url</p>
                        <i class="bi bi-arrow-right-circle connect-node" @onclick="() => { ShowConnectToMoneroNodeModal = true; MoneroNodeToConnectTo = urlConnection.Url; }" />
                        <i class="bi bi-x-circle remove-node" @onclick="() => { ShowRemoveMoneroNodeModal = true; MoneroNodeToRemove = urlConnection.Url; }" />
                    </li>
                }
            </ul>
        }
    </div>
    <button disabled="@(!IsConnected)" @onclick="() => ShowAddMoneroNodeModal = true">Add Monero node</button>
    <Toggle Disabled=@(!IsConnected) OnToggledChanged="SetAutoSwitchAsync" @bind-IsToggled="IsAutoSwitchEnabled" Text="Use any Monero node"></Toggle>
    <p class="note">Note: disable this to ensure the app only uses the selected node</p>
    <br/>
    <p class="bold-p">Preferences</p>
    <div class="dropdown">
        <SearchableDropdown InitialValue="@Countries.First().Key" Items="Countries" Disabled="true" Text="Language" Placeholder="Choose language"></SearchableDropdown>
    </div>
    <div class="dropdown">
        <SearchableDropdown InitialValue="@PreferredCurrency" Items="Currencies" Text="Currency" Placeholder="Choose currency" OnSubmit="HandlePreferredCurrencySubmitAsync"></SearchableDropdown>
    </div>
    <div class="backup-buttons">
        <button class="backup-btn button-green" @onclick="BackupAsync">Backup account</button>
        <button disabled="@(DaemonInstallOption == DaemonInstallOptions.RemoteNode)" class="backup-btn" @onclick="() => ShowRestoreModal = true">Restore account</button>
    </div>

    <Toggle OnToggledChanged="HandleNotificationsToggleAsync" @bind-IsToggled="IsNotificationsToggled" Text="Notifications" />
    @if (DaemonInstallOption == DaemonInstallOptions.Standalone)
    {
        <Toggle OnToggledChanged="HandleNativeWalletToggle" @bind-IsToggled="UseNativeXmrWallet" Text="Use native wallet (experimental)" />
        <p class="note">Note: Uses native wallet libraries instead of monero-wallet-rpc. Restart your device to apply changes; closing the app may leave Haveno running in the background.</p>
        <Toggle OnToggledChanged="HandleWakeLockToggle" @bind-IsToggled="IsWakeLockToggled" Text="Keep offers open in background" />
        <p class="note">Note: This uses more battery</p>        
    }

    @if (DaemonInstallOption == DaemonInstallOptions.RemoteNode)
    {
        <p class="bold-p remote-node-txt">Remote node configuration</p>
        <div class="@(IsRemoteNodeToggled ? "remote-node-section" : "remote-node-section remote-node-disabled")">
            <button @onclick="ScanQRCodeAsync" class="qr-btn">Scan QR code</button>
            <p class="or">Or</p>
            <label class="bold-p">Onion Address</label>
            <input @bind="Host" type="text"/>
            <label class="bold-p">Password</label>
            <input @bind="Password" type="password" />
            <p class="note">Note: you need to have Orbot installed</p>
            <button @onclick="ConnectToRemoteNodeAsync">Connect to remote node</button>
        </div>
    }
</div>
